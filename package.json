{
  "name": "prosperify-api",
  "version": "1.0.0",
  "description": "Prosperify Appointment Scheduling API",
  "author": {
    "name": "Raylson Alves Marques"
  },
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node -r dotenv/config -r tsconfig-paths/register ./src/ProsperifyApplication.ts",
    "build": "tsc && tsc-alias",
    "typeorm:cli": "ts-node -r dotenv/config -r tsconfig-paths/register --project tsconfig.migration.json ./node_modules/typeorm/cli.js",
    "migration:create": "bash -c 'npm run typeorm:cli -- migration:create ./src/shared/infra/database/migrations/$0' $1",
    "migration:generate": "bash -c 'npm run typeorm:cli -- -d ./ormconfig.ts migration:generate ./src/shared/infra/database/migrations/$0' $1",
    "migration:run": "npm run typeorm:cli -- -d ./ormconfig.ts migration:run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.9",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-range": "^4.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typedi": "^0.10.0",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.11.29",
    "@types/node": "^24.9.1",
    "@types/prettier": "^2.7.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.55.0"
  }
}
